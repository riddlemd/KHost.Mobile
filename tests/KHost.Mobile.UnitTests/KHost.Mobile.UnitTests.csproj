<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <!-- Pure, no-I/O logic: the vendor parsers, the matching helpers, Genres, SongListItem, the scoring and
       picking rules. None of it lives in the MAUI head any more, so this project references what it needs
       instead of <Compile Include>-linking the source file by file. Real filesystem I/O is exercised in
       KHost.Mobile.IntegrationTests. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\KHost.Mobile.Abstractions\KHost.Mobile.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\KHost.Mobile.Common\KHost.Mobile.Common.csproj" />
    <ProjectReference Include="..\..\src\KHost.Mobile.Infrastructure\KHost.Mobile.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\KHost.Mobile.Clients\KHost.Mobile.Clients.csproj" />
  </ItemGroup>

</Project>
