<Project Sdk="Microsoft.NET.Sdk">

  <!-- The contract layer: interfaces, models, DTOs and exceptions, and nothing that implements them.
       It references NO other project and NO package on purpose — that is what lets the test projects,
       and one day a Razor Class Library, depend on the app's shape without dragging in MAUI or a
       single third-party backend. Adding a reference here is almost always the wrong fix. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Pinned so the moved files keep their original namespaces (KHost.Mobile.Models, .Services,
         .Clients.*) instead of picking up the assembly name. Renaming the assembly must not rename
         every namespace in the app. -->
    <RootNamespace>KHost.Mobile</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
