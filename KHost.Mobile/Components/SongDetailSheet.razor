@using KHost.Mobile.Models
@inject IAppSettings Settings
@inject IAlbumArtService AlbumArt
@inject IJSRuntime JS

@* Shared song detail card. Shown when @Item is set: the song's fields, its ratings and history, the quick links,
   and (when AllowEdit) an edit form. Presentational — it owns only the edit buffers and its own pull-down-to-dismiss;
   the host owns the @Item state, does every store write and link launch, and supplies the values it can't derive on
   its own (the rating math, whether the song is in tonight). Reused by My Songs and the Tonight tab.
   An action's button renders only when the host wired its callback, so a host that can't service one (Tonight has
   no lyrics or history sheet of its own) simply doesn't offer it. *@
<Sheet Open="Item is not null" OnClose="OnClose" AriaLabel="Song details">
    @if (Item is not null)
    {

        @if (!_editing)
        {
            @* Asks the art service itself rather than being handed a style, like every other art surface. That
               also means opening a song nobody has scrolled to yet fetches its cover. *@
            var art = AlbumArt.ViewFor(Item);
            <div class="sheet__header @(art.HasArt ? "sheet__header--art" : "") @(art.Loading ? "kh-art-loading" : "")"
                 data-art-song="@Item.Id" style="@art.Style">
                <div class="sheet__title">
                    @Item.Title
                    @if (HasSuggestion)
                    {
                        @* Beside the name, because the name is what's wrong. The offer itself stays folded away
                           until asked for — it's a guess, and it shouldn't push the song's own details down. *@
                        <button type="button" class="sheet__typo" aria-expanded="@_suggestionOpen"
                                aria-label="Possible misspelling — show the suggested spelling"
                                title="Possible misspelling"
                                @onclick="() => _suggestionOpen = !_suggestionOpen">⚠</button>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Item.Artist))
                {
                    <div class="sheet__subtitle">@Item.Artist</div>
                }
            </div>
            @if (HasSuggestion && _suggestionOpen)
            {
                <div class="typo-hint">
                    <div class="typo-hint__text">
                        Did you mean <strong>@Item.SuggestedTitle</strong> — <strong>@Item.SuggestedArtist</strong>?
                    </div>
                    <div class="typo-hint__actions">
                        <button class="btn btn-primary typo-hint__apply" @onclick="OnApplySuggestion">Use this</button>
                        <button class="btn-link typo-hint__dismiss" @onclick="OnDismissSuggestion">Not a typo</button>
                    </div>
                </div>
            }
            <div class="sheet__rows">
                <div class="sheet__row">
                    <span class="sheet__key">Genre</span>
                    <span class="sheet__val">
                        @if (!string.IsNullOrWhiteSpace(Item.Genre))
                        {
                            @Item.Genre
                        }
                        else
                        {
                            <span class="sheet__muted">@(SuggestionLoading ? "…" : "—")</span>
                        }
                    </span>
                </div>
                <div class="sheet__row">
                    <span class="sheet__key">Year</span>
                    <span class="sheet__val">
                        @if (Item.Year.HasValue)
                        {
                            @Item.Year
                        }
                        else
                        {
                            <span class="sheet__muted">@(SuggestionLoading ? "…" : "—")</span>
                        }
                    </span>
                </div>
                @if (Settings.TagsEnabled)
                {
                    <div class="sheet__row">
                        <span class="sheet__key">Tags</span>
                        <span class="sheet__val">
                            @if (Item.Tags.Count > 0)
                            {
                                <span class="sheet__tags">
                                    @foreach (var tag in Item.Tags)
                                    {
                                        <span class="tag-chip">@tag</span>
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="sheet__muted">—</span>
                            }
                        </span>
                    </div>
                }
                <div class="sheet__row">
                    <span class="sheet__key">How it went</span>
                    <span class="sheet__val">
                        @if (Item.Performances.Count == 0)
                        {
                            <span class="sheet__muted">unsung</span>
                        }
                        else if (BayesScore is { } score)
                        {
                            <StarRating Value="RoundedAverage" Tone="hot" Sung="true" ReadOnly="true" />
                            <span class="rating-num">@score.ToString("0.0")</span>
                        }
                        else
                        {
                            <span class="sheet__muted">not rated</span>
                        }
                    </span>
                </div>
                <div class="sheet__row">
                    <span class="sheet__key">Enjoyment</span>
                    <span class="sheet__val">
                        <StarRating Value="Item.Enjoyment" Tone="cool" Sung="true" ValueChanged="OnEnjoymentChanged" />
                    </span>
                </div>
                <div class="sheet__row">
                    <span class="sheet__key">Notes</span>
                    <span class="sheet__val">@(string.IsNullOrWhiteSpace(Item.Notes) ? "—" : Item.Notes)</span>
                </div>
                <div class="sheet__row">
                    <span class="sheet__key">Last</span>
                    <span class="sheet__val">
                        @if (Item.LastSungAt.HasValue && OnOpenHistory.HasDelegate)
                        {
                            <button class="btn-link sheet__history-link" @onclick="OnOpenHistory">
                                @Item.LastSungAt.Value.ToString("MMM d, yyyy · h:mm tt")
                                <span class="sheet__history-count">(@Item.Performances.Count)</span>
                            </button>
                        }
                        else if (Item.LastSungAt.HasValue)
                        {
                            @Item.LastSungAt.Value.ToString("MMM d, yyyy · h:mm tt")
                        }
                        else
                        {
                            <span class="sheet__muted">never</span>
                        }
                    </span>
                </div>
                <div class="sheet__row">
                    <span class="sheet__key">Added</span>
                    <span class="sheet__val">@Item.AddedAt.ToString("MMM d, yyyy")</span>
                </div>
            </div>
            @if (AutoFilledNote is not null)
            {
                <div class="suggest-match">@AutoFilledNote</div>
            }
            @if (OnLogPerformance.HasDelegate)
            {
                <button class="btn btn-secondary sheet__log-btn" @onclick="OnLogPerformance">
                    @(Item.Performances.Count > 0 ? "Log another performance" : "Log performance")
                </button>
            }
            @if (Settings.TonightEnabled && OnToggleTonight.HasDelegate)
            {
                <button class="btn sheet__tonight @(InTonight ? "is-on" : "")" @onclick="OnToggleTonight">
                    @(InTonight ? "🎤 In tonight ✓" : "🎤 Add to tonight")
                </button>
            }
            @if (Settings.YouTubeSearchEnabled && OnOpenYouTube.HasDelegate)
            {
                <button class="btn sheet__youtube" @onclick="OnOpenYouTube">▶ Find on YouTube</button>
            }
            @if (Settings.SpotifySearchEnabled && OnOpenSpotify.HasDelegate)
            {
                <button class="btn sheet__spotify" @onclick="OnOpenSpotify">
                    <SpotifyIcon Size="18" Fill="#fff" />
                    Find on Spotify
                </button>
            }
            @if (KaraFunAvailable)
            {
                @if (Settings.TonightEnabled && !InTonight)
                {
                    @* Split button: the main segment opens KaraFun; the chevron queues the song for tonight first,
                       then opens it. Degrades to a plain button below when Tonight is off (no menu to offer) OR the
                       song is already queued for tonight (the "add to tonight" shortcut would be a no-op — the
                       sheet's "🎤 In tonight ✓" row above already shows it's on deck). *@
                    <SplitButton Class="kh-split--karafun" PrimaryLabel="🎙 Find on KaraFun"
                                 OnPrimary="OnOpenKaraFun" Direction="SplitDirection.Up"
                                 ToggleAriaLabel="More KaraFun options">
                        <SplitButtonItem Icon="🎤" Description="Queue it for tonight, then open KaraFun"
                                         OnClick="OnAddToTonightAndOpenKaraFun">
                            Add to tonight &amp; open
                        </SplitButtonItem>
                    </SplitButton>
                }
                else
                {
                    <button class="btn sheet__karafun" @onclick="OnOpenKaraFun">🎙 Find on KaraFun</button>
                }
            }
            @if (Settings.LyricsEnabled && OnOpenLyrics.HasDelegate)
            {
                <button class="btn sheet__lyrics" @onclick="OnOpenLyrics">📖 Lyrics</button>
            }
            @if (AllowEdit)
            {
                <div class="sheet__actions">
                    <button class="btn btn-primary" @onclick="StartEdit">Edit</button>
                </div>
            }
        }
        else
        {
            <div class="sheet__title">Edit song</div>
            <div class="field">
                <label class="field__label" for="e-title">Song title</label>
                <input id="e-title" class="input" @bind="_editTitle" @bind:event="oninput" />
            </div>
            <div class="field">
                <label class="field__label" for="e-artist">Artist</label>
                <input id="e-artist" class="input" @bind="_editArtist" @bind:event="oninput" />
            </div>
            <div class="field">
                <label class="field__label" for="e-genre">Genre <span class="field__hint">— optional</span></label>
                <select id="e-genre" class="input" @bind="_editGenre">
                    <option value=""></option>
                    @foreach (var g in Genres.All)
                    {
                        <option value="@g">@g</option>
                    }
                </select>
            </div>
            <div class="field">
                <label class="field__label" for="e-year">Release year <span class="field__hint">— optional</span></label>
                <input id="e-year" class="input num-year" type="text" inputmode="numeric" maxlength="4"
                       @bind="_editYear" @bind:event="oninput" />
                @if (_editYear.HasValue && !EditYearValid)
                {
                    <div class="field__error">Enter a year between 1 and @CurrentYear.</div>
                }
            </div>
            <div class="field">
                <label class="field__label" for="e-notes">Notes</label>
                <textarea id="e-notes" class="input sheet__notes" rows="3"
                          placeholder="e.g. start slow, key of G" @bind="_editNotes" @bind:event="oninput"></textarea>
            </div>
            @if (Settings.TagsEnabled)
            {
                <div class="field">
                    <label class="field__label">Tags <span class="field__hint">— optional</span></label>
                    <TagInput Tags="_editTags" TagsChanged="v => _editTags = v" Suggestions="UsedTags" />
                </div>
            }
            <div class="sheet__actions">
                <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveEditAsync" disabled="@(!CanSaveEdit)">Save</button>
            </div>
        }
    }
</Sheet>

@code {
    /// <summary>The song to show. Null hides the sheet; setting a different song reopens it in view mode.</summary>
    [Parameter] public SongListItem? Item { get; set; }

    /// <summary>True while a metadata lookup is in flight, so blank genre/year read as "…" rather than "—".</summary>
    [Parameter] public bool SuggestionLoading { get; set; }

    /// <summary>"We filled in X" note from the last auto-fill, shown under the fields. Null hides it.</summary>
    [Parameter] public string? AutoFilledNote { get; set; }

    /// <summary>Takes the song's <see cref="SongListItem.SuggestedTitle"/>/<see cref="SongListItem.SuggestedArtist"/>
    /// as the real spelling. Leave unwired to hide the hint entirely.</summary>
    [Parameter] public EventCallback OnApplySuggestion { get; set; }

    /// <summary>Rejects the suggested spelling for good.</summary>
    [Parameter] public EventCallback OnDismissSuggestion { get; set; }

    /// <summary>Whether the song is already on tonight's set — drives the Tonight button's label and the KaraFun split.</summary>
    [Parameter] public bool InTonight { get; set; }

    /// <summary>Whether to offer KaraFun: the host resolves the setting AND the active venue's KaraFun ID.</summary>
    [Parameter] public bool KaraFunAvailable { get; set; }

    /// <summary>Confidence-weighted star for "how it went"; null renders "not rated".</summary>
    [Parameter] public double? BayesScore { get; set; }

    /// <summary>Whole-star value the "how it went" rating draws, paired with <see cref="BayesScore"/>.</summary>
    [Parameter] public int RoundedAverage { get; set; }

    /// <summary>Existing tags across the list, offered as suggestions in the edit form.</summary>
    [Parameter] public IReadOnlyList<string> UsedTags { get; set; } = [];

    /// <summary>Whether to offer Edit. Tonight opens the card read-only — a set list is for singing, not curating.</summary>
    [Parameter] public bool AllowEdit { get; set; } = true;

    /// <summary>Raised on ✕, the backdrop, or a pull-down dismiss. The host clears <see cref="Item"/>.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Raised by "Log performance" / "Log another performance" — the host runs its rating prompt.</summary>
    [Parameter] public EventCallback OnLogPerformance { get; set; }

    /// <summary>Raised by the Tonight button; the host adds or removes the song.</summary>
    [Parameter] public EventCallback OnToggleTonight { get; set; }

    /// <summary>Raised by the "Last" date link; the host opens its history sheet.</summary>
    [Parameter] public EventCallback OnOpenHistory { get; set; }

    /// <summary>Quick-link taps. The host owns the URL building and the launch.</summary>
    [Parameter] public EventCallback OnOpenYouTube { get; set; }

    /// <inheritdoc cref="OnOpenYouTube" />
    [Parameter] public EventCallback OnOpenSpotify { get; set; }

    /// <inheritdoc cref="OnOpenYouTube" />
    [Parameter] public EventCallback OnOpenKaraFun { get; set; }

    /// <inheritdoc cref="OnOpenYouTube" />
    [Parameter] public EventCallback OnOpenLyrics { get; set; }

    /// <summary>The KaraFun split button's menu action: queue the song for tonight, then open KaraFun.</summary>
    [Parameter] public EventCallback OnAddToTonightAndOpenKaraFun { get; set; }

    /// <summary>New enjoyment rating; the host persists it.</summary>
    [Parameter] public EventCallback<int> OnEnjoymentChanged { get; set; }

    /// <summary>The edited values, on Save. The host applies them to the song and persists.</summary>
    [Parameter] public EventCallback<Edit> OnSave { get; set; }

    /// <summary>The edit form's values, handed to the host to apply. Tags are raw — the host normalizes.</summary>
    public sealed record Edit(string Title, string Artist, string Genre, int? Year, string Notes, List<string> Tags);

    private bool _editing;
    private string _editTitle = string.Empty;
    private string _editArtist = string.Empty;
    private string _editGenre = string.Empty;
    private string _editNotes = string.Empty;
    private int? _editYear;
    private List<string> _editTags = [];
    private Guid? _openFor;   // the song the sheet is currently showing; a change means a fresh open → leave edit mode

    private bool _editFieldsBound;

    private static int CurrentYear => DateTime.Now.Year;
    private bool EditYearValid => !_editYear.HasValue || (_editYear.Value >= 1 && _editYear.Value <= CurrentYear);
    private bool CanSaveEdit => !string.IsNullOrWhiteSpace(_editTitle) && EditYearValid;

    // Shown only when the host wired both answers — the read-only Tonight host can't service either.
    private bool HasSuggestion =>
        Item is { HasSuggestion: true } && OnApplySuggestion.HasDelegate && OnDismissSuggestion.HasDelegate;

    private bool _suggestionOpen;

    protected override void OnParametersSet()
    {
        if (Item?.Id != _openFor)
        {
            _openFor = Item?.Id;
            _editing = false;
            _suggestionOpen = false;   // a different song's offer starts folded away
        }
        if (!HasSuggestion)
            _suggestionOpen = false;   // applied or dismissed: nothing left to show
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The edit form's year input needs the digit-only guard once it's rendered.
        if (_editing && !_editFieldsBound)
        {
            await JS.InvokeVoidAsync("khNumeric.register");
            _editFieldsBound = true;
        }
        else if (!_editing)
        {
            _editFieldsBound = false;
        }
    }

    private void StartEdit()
    {
        if (Item is null)
            return;
        _editTitle = Item.Title;
        _editArtist = Item.Artist;
        _editGenre = Item.Genre ?? string.Empty;
        _editNotes = Item.Notes ?? string.Empty;
        _editYear = Item.Year;
        _editTags = [.. Item.Tags];
        _editing = true;
    }

    private void CancelEdit() => _editing = false;

    private async Task SaveEditAsync()
    {
        if (Item is null || !CanSaveEdit)
            return;

        await OnSave.InvokeAsync(new Edit(_editTitle.Trim(), _editArtist.Trim(), _editGenre, _editYear, _editNotes, _editTags));
        _editing = false;
    }

}
