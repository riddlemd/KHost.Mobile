@* Picks one release year from a grid of the years actually present in the library. A grid rather than a long
   list because a span like 1960–2025 is 60+ rows to scroll but only ~13 rows as a grid — the same reason the
   platform date pickers show years in a grid. Years that would put the two range handles the wrong way round
   are rendered disabled rather than silently clamped, so the pick you make is the pick you get. *@

@* ClosePx matches the other sheets with an inner scrolling list, so a scroll-flick in the grid can't
   dismiss the sheet by accident. *@
<Sheet Open="Open" Class="sheet--year" BackdropClass="sheet-backdrop--year" AriaLabel="@Title"
       ClosePx="150" OnClose="OnClose">
    <div class="sheet__title">@Title</div>
    <div class="year-grid" role="listbox" aria-label="@Title">
        @foreach (var year in Years)
        {
            var allowed = year >= Min && year <= Max;
            <button type="button" class="year-grid__item @(year == Selected ? "is-sel" : "")"
                    role="option" aria-selected="@(year == Selected)" disabled="@(!allowed)"
                    @onclick="() => OnPick.InvokeAsync(year)">@year</button>
        }
    </div>
</Sheet>

@code {
    /// <summary>Whether the sheet is showing.</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Heading, and the dialog's accessible name (e.g. "Earliest year").</summary>
    [Parameter] public string Title { get; set; } = "Year";

    /// <summary>The selectable years, ascending — the distinct years present in the library.</summary>
    [Parameter] public IReadOnlyList<int> Years { get; set; } = [];

    /// <summary>The currently picked year, highlighted in the grid.</summary>
    [Parameter] public int Selected { get; set; }

    /// <summary>Lowest year that may be picked; anything below renders disabled.</summary>
    [Parameter] public int Min { get; set; } = int.MinValue;

    /// <summary>Highest year that may be picked; anything above renders disabled.</summary>
    [Parameter] public int Max { get; set; } = int.MaxValue;

    /// <summary>Raised with the chosen year.</summary>
    [Parameter] public EventCallback<int> OnPick { get; set; }

    /// <summary>Raised by the ✕, the backdrop and a pull-down dismiss.</summary>
    [Parameter] public EventCallback OnClose { get; set; }
}
