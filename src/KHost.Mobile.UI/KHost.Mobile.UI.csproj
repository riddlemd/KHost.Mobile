<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!-- The Razor UI, deliberately WITHOUT the MAUI workload: a component physically cannot reach a MAUI type
         from here, so "only the head knows MAUI" is enforced by the compiler rather than by review. Platform
         capabilities arrive as Abstractions interfaces, implemented by the Maui* adapters in KHost.Mobile. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    </PropertyGroup>

    <!-- The code-behind analogue of Components/_Imports.razor: a .razor.cs is a normal C# file and inherits none
         of the markup's @using, so the same set is global here rather than repeated in 30-odd partials. -->
    <ItemGroup>
        <Using Include="KHost.Mobile.Abstractions.Models" />
        <Using Include="KHost.Mobile.Abstractions.Services" />
        <Using Include="KHost.Mobile.Infrastructure.Services" />
        <Using Include="KHost.Mobile.UI.Components" />
        <Using Include="KHost.Mobile.UI.Components.Icons" />
        <Using Include="KHost.Mobile.UI.Components.Layout" />
        <Using Include="KHost.Mobile.UI.Components.Sheets" />
        <Using Include="KHost.Mobile.UI.Services" />
        <Using Include="Microsoft.AspNetCore.Components" />
        <Using Include="Microsoft.AspNetCore.Components.Routing" />
        <Using Include="Microsoft.AspNetCore.Components.Web" />
        <Using Include="Microsoft.JSInterop" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\KHost.Mobile.Abstractions\KHost.Mobile.Abstractions.csproj" />
      <ProjectReference Include="..\KHost.Mobile.Common\KHost.Mobile.Common.csproj" />
      <ProjectReference Include="..\KHost.Mobile.Infrastructure\KHost.Mobile.Infrastructure.csproj" />
      <ProjectReference Include="..\KHost.Mobile.Clients\KHost.Mobile.Clients.csproj" />
    </ItemGroup>

</Project>
