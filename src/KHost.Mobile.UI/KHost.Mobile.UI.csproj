<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!-- The Razor UI, deliberately WITHOUT the MAUI workload: a component physically cannot reach a MAUI type
         from here, so "only the head knows MAUI" is enforced by the compiler rather than by review. Platform
         capabilities arrive as Abstractions interfaces, implemented by the Maui* adapters in KHost.Mobile. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\KHost.Mobile.Abstractions\KHost.Mobile.Abstractions.csproj" />
      <ProjectReference Include="..\KHost.Mobile.Common\KHost.Mobile.Common.csproj" />
      <ProjectReference Include="..\KHost.Mobile.Infrastructure\KHost.Mobile.Infrastructure.csproj" />
      <ProjectReference Include="..\KHost.Mobile.Clients\KHost.Mobile.Clients.csproj" />
    </ItemGroup>

</Project>
