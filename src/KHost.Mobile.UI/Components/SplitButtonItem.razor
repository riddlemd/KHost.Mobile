@* One row in a <see cref="SplitButton"/>'s dropdown. Runs its OnClick, then asks the parent to close the menu. *@
<button type="button" class="kh-split__item @(Separated ? "kh-split__item--sep" : "")" role="menuitem"
        disabled="@Disabled" @onclick="ClickAsync">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <span class="kh-split__item-icon" aria-hidden="true">@Icon</span>
    }
    <span class="kh-split__item-body">
        <span class="kh-split__item-label">@ChildContent</span>
        @if (!string.IsNullOrEmpty(Description))
        {
            <span class="kh-split__item-desc">@Description</span>
        }
    </span>
</button>
