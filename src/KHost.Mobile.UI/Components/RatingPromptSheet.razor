@inject TimeProvider Clock

@* Shared "Sang it" prompt (My Songs "Log performance" + the Tonight check-off). Presentational only — the host
   owns the @Item state and decides what a commit means.

   A pull-down dismiss here LOGS the sing unrated (same as Skip) rather than discarding it, so it takes the
   OnSwipeDismiss path instead of OnClose. *@
<Sheet Open="Item is not null" Class="sheet--history rating-prompt" BackdropClass="sheet-backdrop--history"
       AriaLabel="How did it go?" OnClose="CancelAsync" OnSwipeDismiss="DismissFromSwipeAsync">
    @if (Item is not null)
    {
        <div class="sheet__title">@(RatePerformances ? "How did it go?" : "Have any notes?")</div>
        <div class="sheet__subtitle">@Item.Title</div>
        @if (RatePerformances)
        {
            <StarRating Value="_value" Tone="hot" Sung="true" ValueChanged="v => _value = v" />
            <div class="rating-prompt__hint">@Hint</div>
        }
        @* Defaults to now; editable so a sing you forgot to log can be dated when it actually happened.
           The control's own display format follows the device locale, not the app's 12/24-hour setting. *@
        <label class="rating-prompt__when">
            <span class="rating-prompt__when-label">When</span>
            <input class="input input--sm" type="datetime-local" aria-label="Date and time sung"
                   value="@_when" @onchange="OnWhenChanged" />
        </label>
        <input class="input input--sm rating-prompt__note" placeholder="Add a note (optional)"
               @bind="_note" @bind:event="oninput" />
        <div class="sheet__actions">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@(RatePerformances && _value < 1)">Save</button>
        </div>
        @if (RatePerformances)
        {
            <button type="button" class="btn-link rating-prompt__skip" @onclick="SkipAsync">Skip — just log that I sang it</button>
        }
    }
</Sheet>

@code {
    /// <summary>The song a performance is being logged for. Null hides the sheet; setting it (re)opens the prompt reset to blank.</summary>
    [Parameter] public SongListItem? Item { get; set; }

    /// <summary>When true, show the "how it went" stars + Skip; when false, the prompt only collects an optional note.</summary>
    [Parameter] public bool RatePerformances { get; set; }

    /// <summary>Raised when the sing is logged — Save (with the rating), Skip, or a pull-down dismiss (both → 0).
    /// Carries the chosen how-it-went (0 when unrated/skipped), the optional note, and when it was sung.</summary>
    [Parameter] public EventCallback<(int howItWent, string? note, DateTimeOffset when)> OnCommit { get; set; }

    /// <summary>Raised when the prompt is dismissed WITHOUT logging (the ✕ or the backdrop).</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    private int _value;
    private string _note = string.Empty;
    private string _when = string.Empty;
    private Guid? _openFor;   // the item id the current buffers belong to; a change means a fresh open → reset

    private string Hint => _value switch
    {
        1 => "Not confident",
        2 => "Shaky",
        3 => "Okay",
        4 => "Confident",
        5 => "Nailed it",
        _ => "Tap a star to rate — or skip below",
    };

    protected override void OnParametersSet()
    {
        if (Item?.Id != _openFor)
        {
            _openFor = Item?.Id;
            _value = 0;
            _note = string.Empty;
            _when = LocalDateTimeInput.Format(Clock.GetLocalNow(), Clock);
        }
    }

    private void OnWhenChanged(ChangeEventArgs e) => _when = e.Value?.ToString() ?? string.Empty;

    // A cleared or unparseable field falls back to now, so a commit never fails on the date.
    private DateTimeOffset When =>
        LocalDateTimeInput.TryParse(_when, Clock, out var when) ? when : Clock.GetLocalNow();

    private Task SaveAsync() => OnCommit.InvokeAsync((_value, _note, When));

    private Task SkipAsync() => OnCommit.InvokeAsync((0, _note, When));

    private Task CancelAsync() => OnCancel.InvokeAsync();

    private Task DismissFromSwipeAsync() => OnCommit.InvokeAsync((0, _note, When));
}
