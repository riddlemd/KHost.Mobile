@using Microsoft.Extensions.Logging
@inject ITonightStore Tonight
@inject ILogger<NavMenu> Log

@* Bottom tab bar. Only rendered when Tonight is enabled (MainLayout gates it), so both tabs are always live here. *@
<nav class="app-nav">
    <NavLink class="app-nav__tab" href="tonight" data-tut="tonight">
        <span class="app-nav__icon">
            🎤
            @if (_remaining > 0)
            {
                <span class="app-nav__badge">@_remaining</span>
            }
        </span>
        Tonight
    </NavLink>
    <NavLink class="app-nav__tab" href="" Match="NavLinkMatch.All">
        <span class="app-nav__icon">📓</span>
        My Songs
    </NavLink>
</nav>
