@* Chip-input for a song's free-form tags. Controlled — it never mutates Tags, it raises TagsChanged with a fresh
   normalized list. Suggestions offers existing tags to reuse, so casing/near-duplicate variants don't proliferate. *@
<div class="chip-input" @onclick="FocusEntryAsync">
    @foreach (var tag in Tags)
    {
        <span class="chip-input__chip" @key="tag">
            @tag
            <button type="button" class="chip-input__x" aria-label="@($"Remove tag {tag}")"
                    @onclick="() => RemoveAsync(tag)" @onclick:stopPropagation="true">✕</button>
        </span>
    }
    <input @ref="_entryRef" class="chip-input__entry" type="text"
           placeholder="@(Tags.Count == 0 ? Placeholder : string.Empty)"
           @bind="_entry" @bind:event="oninput" @bind:after="OnEntryChangedAsync"
           @onkeydown="OnKeyDownAsync" @onclick:stopPropagation="true" />
</div>
<div class="chip-input__hint">Press <b>Enter</b> or <b>,</b> to add@(Tags.Count >= SongTags.MaxCount ? $" · max {SongTags.MaxCount} reached" : string.Empty)</div>

@{
    var suggestions = VisibleSuggestions.ToList();
}
@if (suggestions.Count > 0)
{
    <div class="chip-suggest__label">Reuse an existing tag</div>
    <div class="chip-suggest">
        @foreach (var s in suggestions)
        {
            <button type="button" class="chip-suggest__chip" @key="s" @onclick="() => CommitAsync(s)">+ @s</button>
        }
    </div>
}
