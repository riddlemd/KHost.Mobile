@* Collapsible color + glyph picker, shared by the singer editor (color + emoji + letter fallback) and the venue
   editor (emoji only). Two-way binds Glyph, and Color when a palette is supplied. *@

<div class="icon-picker">
    <div class="icon-picker__row">
        <button type="button"
                class="icon-picker__preview @(HasColor ? "icon-picker__preview--avatar" : "icon-picker__preview--tile") @(_open ? "is-open" : "")"
                style="@(HasColor ? $"background:{Color};" : "")"
                @onclick="Toggle" aria-haspopup="true" aria-expanded="@_open" aria-label="Change icon" title="Change icon">
            @Preview
        </button>
        @ChildContent
    </div>

    @if (_open)
    {
        <div class="icon-picker__panel">
            @if (HasColorPalette)
            {
                <div class="color-grid" role="radiogroup" aria-label="Color">
                    @foreach (var c in AvailableColors!)
                    {
                        <button type="button" class="color-grid__item @(c == Color ? "is-sel" : "")"
                                style="background:@c;" role="radio" aria-checked="@(c == Color)"
                                @onclick="() => SelectColorAsync(c)" aria-label="Color option"></button>
                    }
                </div>
            }
            <div class="glyph-grid @(HasColorPalette ? "icon-picker__glyphs--accent" : "")" role="radiogroup" aria-label="Icon">
                @* The letter tile selects "no glyph" — an empty string, not a value of its own. *@
                @if (LetterFallback is not null)
                {
                    <button type="button" class="glyph-grid__item glyph-grid__item--letter @(string.IsNullOrEmpty(Glyph) ? "is-sel" : "")"
                            role="radio" aria-checked="@(string.IsNullOrEmpty(Glyph))" @onclick="() => SelectGlyphAsync(string.Empty)"
                            aria-label="Use first letter">@LetterFallback</button>
                }
                @foreach (var g in AvailableGlyphs)
                {
                    <button type="button" class="glyph-grid__item @(g == Glyph ? "is-sel" : "")"
                            role="radio" aria-checked="@(g == Glyph)" @onclick="() => SelectGlyphAsync(g)" aria-label="Icon option">@g</button>
                }
            </div>
        </div>
    }
</div>
