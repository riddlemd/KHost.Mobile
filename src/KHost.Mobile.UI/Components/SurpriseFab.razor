@inject IJSRuntime JS
@inject IHaptics Haptics

@* The 🎲 FAB: tap rolls, press-and-hold opens the options. No assistive-tech gesture maps to a long press,
   so the host must offer another route to the options — My Songs uses the result sheet's "Options" action. *@
<button type="button" @ref="_el"
        class="mysongs-fab mysongs-fab--surprise @(NoNav ? "mysongs-fab--no-nav" : "") @(Hidden ? "is-hidden" : "")"
        data-tut="surprise"
        aria-label="Surprise me — pick a song at random. Press and hold for options."
        aria-haspopup="dialog">
    <span class="mysongs-fab__dice" aria-hidden="true">🎲</span>
</button>
