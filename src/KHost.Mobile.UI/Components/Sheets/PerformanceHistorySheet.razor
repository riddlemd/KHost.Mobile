@inject IJSRuntime JS
@inject IAppSettings Settings
@inject ITimeFormatter Time

@* Every performance of one song: when, how it went, and a note. Rows carry the standard row gestures (swipe.js):
   swipe left to remove, press and hold to change the date. swipe.js ignores the note field and the stars, so a
   hold lands on the date. The undo and the date editor live here; the host only persists the resulting change. *@
<Sheet Open="Item is not null"
       AriaLabel="Performance history" ClosePx="150" OnClose="OnClose">
    @if (Item is { } item)
    {
        <div class="sheet__title">Performance history</div>
        <div class="sheet__subtitle">
            @item.Title
            @if (BayesScore is { } score)
            {
                <text> · @score.ToString("0.0")★ over @item.Performances.Count performance@(item.Performances.Count == 1 ? "" : "s")</text>
            }
        </div>

        @if (item.Performances.Count == 0)
        {
            @* Removing the last performance leaves the sheet open rather than closing it, so the undo is still
               there to take. *@
            <div class="history__empty">No performances recorded.</div>
        }
        @* Always rendered, even empty: the swipe.js registration binds to this element once per open, so
           dropping it on the last removal would leave the gesture bound to a detached node after an undo. *@
        <div class="history" @ref="_list">
            @foreach (var (perf, index) in item.Performances
                .Select((p, i) => (p, i))
                .OrderByDescending(x => x.p.Date))
            {
                @* Keyed like every other swipeable list: swipe.js leaves the removed row translated off-screen
                   at opacity 0, so an unkeyed diff would hand that same node — inline styles and all — to the
                   next performance, leaving an invisible full-height gap where the deleted row was. *@
                <div class="history__item" @key="perf.Id" data-perf-id="@perf.Id">
                    <div class="history__top">
                        <span class="history__date">@perf.Date.ToString(Time.DateTimePattern(Settings.Use24HourTime))</span>
                        <StarRating Value="perf.HowItWent" Tone="hot" Sung="true"
                                    ValueChanged="v => OnRatingChanged.InvokeAsync((index, v))" />
                    </div>
                    <input class="input input--sm history__note" placeholder="Add a note…"
                           value="@perf.Note" @onchange="e => OnNoteChanged.InvokeAsync((index, e.Value?.ToString()))" />
                </div>
            }
        </div>
        @if (item.Performances.Count > 0)
        {
            @* No assistive-tech gesture maps to swipe or long-press, so both actions are spelled out.
               The undo pill floats over this line, so the hint goes invisible while one is up — hidden rather
               than removed, or the sheet would jump by its height as the pill comes and goes. *@
            <div class="history__hint @(_undone is null ? "" : "is-covered")">Swipe a row left to remove it · press and hold a date to change it</div>
        }
    }
</Sheet>

@* A swipe removes straight away and offers an undo, the way the song, venue and singer lists do. Must stay
   OUTSIDE the Sheet — .snackbar's z-index only outranks it from here. *@
@if (_undone is not null)
{
    <div class="snackbar snackbar--over-sheet" role="status">
        <span class="snackbar__text">Removed @_undone.Date.ToString(Time.DatePattern)</span>
        <button class="snackbar__action" @onclick="UndoRemoveAsync">Undo</button>
    </div>
}

@* datetime-local so the platform's own picker does the work. *@
@if (Item is not null && _editIndex is { } editIndex && editIndex < Item.Performances.Count)
{
    <div class="sheet-backdrop sheet-backdrop--confirm" @onclick="CancelEdit"></div>
    <div class="confirm-pop" role="dialog" aria-modal="true">
        <div class="confirm-pop__title">When was this sung?</div>
        <input class="input confirm-pop__input" type="datetime-local" aria-label="Date and time sung"
               value="@_editDate" @onchange="e => _editDate = e.Value?.ToString() ?? string.Empty" />
        <div class="confirm-pop__actions">
            <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
            <button class="btn btn-primary" @onclick="() => SaveDateAsync(editIndex)"
                    disabled="@string.IsNullOrWhiteSpace(_editDate)">Save</button>
        </div>
    </div>
}
