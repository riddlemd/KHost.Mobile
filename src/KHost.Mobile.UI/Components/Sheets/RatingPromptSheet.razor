@inject TimeProvider Clock
@inject IDateTimeInputConverter DateInput

@* Shared "Sang it" prompt (My Songs "Log performance" + the Tonight check-off). Presentational only — the host
   owns the @Item state and decides what a commit means.

   A pull-down dismiss here LOGS the sing unrated (same as Skip) rather than discarding it, so it takes the
   OnSwipeDismiss path instead of OnClose. *@
<Sheet Open="Item is not null" Class="rating-prompt"
       AriaLabel="How did it go?" OnClose="CancelAsync" OnSwipeDismiss="DismissFromSwipeAsync">
    @if (Item is not null)
    {
        <div class="sheet__title">@(RatePerformances ? "How did it go?" : "Have any notes?")</div>
        <div class="sheet__subtitle">@Item.Title</div>
        @if (RatePerformances)
        {
            <StarRating Value="_value" Tone="hot" Sung="true" ValueChanged="v => _value = v" />
            <div class="rating-prompt__hint">@Hint</div>
        }
        @* The control's display format follows the device locale, not the app's 12/24-hour setting. *@
        <label class="rating-prompt__when">
            <span class="rating-prompt__when-label">When</span>
            <input class="input input--sm" type="datetime-local" aria-label="Date and time sung"
                   value="@_when" @onchange="OnWhenChanged" />
        </label>
        <input class="input input--sm rating-prompt__note" placeholder="Add a note (optional)"
               @bind="_note" @bind:event="oninput" />
        <div class="sheet__actions">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@(RatePerformances && _value < 1)">Save</button>
        </div>
        @if (RatePerformances)
        {
            <button type="button" class="btn-link rating-prompt__skip" @onclick="SkipAsync">Skip — just log that I sang it</button>
        }
    }
</Sheet>
