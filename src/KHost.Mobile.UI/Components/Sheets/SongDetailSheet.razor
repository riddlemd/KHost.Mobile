@using KHost.Mobile.Abstractions.Models
@inject IAppSettings Settings
@inject IAlbumArtService AlbumArt
@inject IJSRuntime JS
@inject TimeProvider Clock
@inject ITimeFormatter Time

@* Shared song detail card (My Songs + Tonight). Presentational — it owns only the edit buffers; the host owns the
   @Item state, does every store write and link launch, and supplies what can't be derived here (the rating math,
   whether the song is in tonight). Each action's button renders only when the host wired its callback, so a host
   that can't service one simply doesn't offer it. *@
<Sheet Open="Item is not null" OnClose="OnClose" AriaLabel="Song details">
    @if (Item is not null)
    {

        @if (!_editing)
        {
            @* Asks the art service rather than taking a style parameter, so opening a song nobody has scrolled
               to yet still fetches its cover. *@
            var art = AlbumArt.ViewFor(Item);
            <div class="sheet__header @(art.HasArt ? "sheet__header--art" : "") @(art.Loading ? "kh-art-loading" : "")"
                 data-art-song="@Item.Id" style="@art.Style">
                <div class="sheet__title">
                    @Item.Title
                    @if (HasSuggestion)
                    {
                        @* Anchored to the name because that's the field the suggestion corrects; the offer itself
                           stays folded until asked for. *@
                        <button type="button" class="sheet__typo" aria-expanded="@_suggestionOpen"
                                aria-label="Possible misspelling — show the suggested spelling"
                                title="Possible misspelling"
                                @onclick="() => _suggestionOpen = !_suggestionOpen">⚠</button>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Item.Artist))
                {
                    <div class="sheet__subtitle">@Item.Artist</div>
                }
            </div>
            @if (HasSuggestion && _suggestionOpen)
            {
                <div class="typo-hint">
                    <div class="typo-hint__text">
                        Did you mean <strong>@Item.SuggestedTitle</strong> — <strong>@Item.SuggestedArtist</strong>?
                    </div>
                    <div class="typo-hint__actions">
                        <button class="btn btn-primary typo-hint__apply" @onclick="OnApplySuggestion">Use this</button>
                        <button class="btn-link typo-hint__dismiss" @onclick="OnDismissSuggestion">Not a typo</button>
                    </div>
                </div>
            }
            <div class="sheet__rows">
                <div class="sheet__row">
                    <span class="sheet__key">Genre</span>
                    <span class="sheet__val">
                        @if (!string.IsNullOrWhiteSpace(Item.Genre))
                        {
                            @Item.Genre
                        }
                        else
                        {
                            <span class="sheet__muted">@(SuggestionLoading ? "…" : "—")</span>
                        }
                    </span>
                </div>
                <div class="sheet__row">
                    <span class="sheet__key">Year</span>
                    <span class="sheet__val">
                        @if (Item.Year.HasValue)
                        {
                            @Item.Year
                        }
                        else
                        {
                            <span class="sheet__muted">@(SuggestionLoading ? "…" : "—")</span>
                        }
                    </span>
                </div>
                @if (Settings.TagsEnabled)
                {
                    <div class="sheet__row">
                        <span class="sheet__key">Tags</span>
                        <span class="sheet__val">
                            @if (Item.Tags.Count > 0)
                            {
                                <span class="sheet__tags">
                                    @foreach (var tag in Item.Tags)
                                    {
                                        <span class="tag-chip">@tag</span>
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="sheet__muted">—</span>
                            }
                        </span>
                    </div>
                }
                <div class="sheet__row">
                    <span class="sheet__key">How it went</span>
                    <span class="sheet__val">
                        @if (Item.Performances.Count == 0)
                        {
                            <span class="sheet__muted">unsung</span>
                        }
                        else if (BayesScore is { } score)
                        {
                            <StarRating Value="RoundedAverage" Tone="hot" Sung="true" ReadOnly="true" />
                            <span class="rating-num">@score.ToString("0.0")</span>
                        }
                        else
                        {
                            <span class="sheet__muted">not rated</span>
                        }
                    </span>
                </div>
                <div class="sheet__row">
                    <span class="sheet__key">Enjoyment</span>
                    <span class="sheet__val">
                        <StarRating Value="Item.Enjoyment" Tone="cool" Sung="true" ValueChanged="OnEnjoymentChanged" />
                    </span>
                </div>
                <div class="sheet__row">
                    <span class="sheet__key">Notes</span>
                    <span class="sheet__val">@(string.IsNullOrWhiteSpace(Item.Notes) ? "—" : Item.Notes)</span>
                </div>
                <div class="sheet__row">
                    <span class="sheet__key">Last</span>
                    <span class="sheet__val">
                        @if (Item.LastSungAt.HasValue && OnOpenHistory.HasDelegate)
                        {
                            <button class="btn-link sheet__history-link" @onclick="OnOpenHistory">
                                @Item.LastSungAt.Value.ToString(Time.DateTimePattern(Settings.Use24HourTime))
                                <span class="sheet__history-count">(@Item.Performances.Count)</span>
                            </button>
                        }
                        else if (Item.LastSungAt.HasValue)
                        {
                            @Item.LastSungAt.Value.ToString(Time.DateTimePattern(Settings.Use24HourTime))
                        }
                        else
                        {
                            <span class="sheet__muted">never</span>
                        }
                    </span>
                </div>
                <div class="sheet__row">
                    <span class="sheet__key">Added</span>
                    <span class="sheet__val">@Item.AddedAt.ToString(Time.DatePattern)</span>
                </div>
            </div>
            @if (AutoFilledNote is not null)
            {
                <div class="suggest-match">@AutoFilledNote</div>
            }
            @if (OnLogPerformance.HasDelegate)
            {
                <button class="btn sheet__log-btn" @onclick="OnLogPerformance">
                    @(Item.Performances.Count > 0 ? "Log another performance" : "Log performance")
                </button>
            }
            @if (Settings.TonightEnabled && OnToggleTonight.HasDelegate)
            {
                <button class="btn sheet__tonight @(InTonight ? "is-on" : "")" @onclick="OnToggleTonight">
                    @(InTonight ? "In Tonight ✓" : "Add to Tonight")
                </button>
            }
            @if (Settings.YouTubeSearchEnabled && OnOpenYouTube.HasDelegate)
            {
                <button class="btn sheet__youtube" @onclick="OnOpenYouTube">▶ Find on YouTube</button>
            }
            @if (Settings.SpotifySearchEnabled && OnOpenSpotify.HasDelegate)
            {
                <button class="btn sheet__spotify" @onclick="OnOpenSpotify">
                    <SpotifyIcon Size="18" Fill="#fff" />
                    Find on Spotify
                </button>
            }
            @if (KaraFunAvailable)
            {
                @if (Settings.TonightEnabled && !InTonight)
                {
                    @* Degrades to the plain button below when Tonight is off (no menu to offer) or the song is
                       already queued (the menu's only item would be a no-op). *@
                    <SplitButton Class="kh-split--karafun" PrimaryLabel="🎙 Find on KaraFun"
                                 OnPrimary="OnOpenKaraFun" Direction="SplitDirection.Up"
                                 ToggleAriaLabel="More KaraFun options">
                        <SplitButtonItem Description="Add to Tonight Queue &amp; then search KaraFun"
                                         OnClick="OnAddToTonightAndOpenKaraFun">
                            Add to Tonight &amp; Find
                        </SplitButtonItem>
                    </SplitButton>
                }
                else
                {
                    <button class="btn sheet__karafun" @onclick="OnOpenKaraFun">🎙 Find on KaraFun</button>
                }
            }
            @if (Settings.LyricsEnabled && OnOpenLyrics.HasDelegate)
            {
                <button class="btn sheet__lyrics" @onclick="OnOpenLyrics">View Lyrics</button>
            }
            @if (AllowEdit)
            {
                <div class="sheet__actions">
                    <button class="btn btn-primary" @onclick="StartEdit">Edit</button>
                </div>
            }
        }
        else
        {
            <div class="sheet__title">Edit song</div>
            <div class="field">
                <label class="field__label" for="e-title">Song title</label>
                <input id="e-title" class="input" @bind="_editTitle" @bind:event="oninput" />
            </div>
            <div class="field">
                <label class="field__label" for="e-artist">Artist</label>
                <input id="e-artist" class="input" @bind="_editArtist" @bind:event="oninput" />
            </div>
            <div class="field">
                <label class="field__label" for="e-genre">Genre <span class="field__hint">— optional</span></label>
                <select id="e-genre" class="input" @bind="_editGenre">
                    <option value=""></option>
                    @foreach (var g in Genres.All)
                    {
                        <option value="@g">@g</option>
                    }
                </select>
            </div>
            <div class="field">
                <label class="field__label" for="e-year">Release year <span class="field__hint">— optional</span></label>
                <input id="e-year" class="input num-year" type="text" inputmode="numeric" maxlength="4"
                       @bind="_editYear" @bind:event="oninput" />
                @if (_editYear.HasValue && !EditYearValid)
                {
                    <div class="field__error">Enter a year between 1 and @CurrentYear.</div>
                }
            </div>
            <div class="field">
                <label class="field__label" for="e-notes">Notes</label>
                <textarea id="e-notes" class="input sheet__notes" rows="3"
                          placeholder="e.g. start slow, key of G" @bind="_editNotes" @bind:event="oninput"></textarea>
            </div>
            @if (Settings.TagsEnabled)
            {
                <div class="field">
                    <label class="field__label">Tags <span class="field__hint">— optional</span></label>
                    <TagInput Tags="_editTags" TagsChanged="v => _editTags = v" Suggestions="UsedTags" />
                </div>
            }
            <div class="sheet__actions">
                <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveEditAsync" disabled="@(!CanSaveEdit)">Save</button>
            </div>
        }
    }
</Sheet>
