@inject IAlbumArtService AlbumArt

@* What the 🎲 picked, shown as the app's own song card. Display-only — the card's usual ★ / add-to-tonight buttons are left
   off so they don't compete with the sheet's own actions right below it. *@
<Sheet Open="Item is not null" Class="sheet--roll" BackdropClass="sheet-backdrop--roll"
       AriaLabel="Your random pick" ClosePx="150" OnClose="OnClose">
    @if (Item is { } item)
    {
        <div class="roll-result__label">Your pick</div>

        @* No Changed subscription of its own — the host must re-render this on AlbumArt.Changed. *@
        var art = AlbumArt.ViewFor(item);
        @* Tappable because the shared .song-card styling carries a pointer cursor and press feedback — inert, the
           card reads as broken. The "Open song" button stays as the labelled, reachable route. *@
        <div class="song-card song-card--roll @(art.HasArt ? "song-card--art" : "") @(art.Loading ? "kh-art-loading" : "")"
             data-art-song="@item.Id" style="@art.Style"
             role="button" tabindex="0" aria-label="Open @item.Title"
             @onclick="OnOpen" @onkeydown="OpenOnEnterOrSpaceAsync">
            <div class="song-card__title">@item.Title</div>
            @if (!string.IsNullOrWhiteSpace(item.Artist))
            {
                <div class="song-card__artist">@item.Artist</div>
            }
            <div class="song-card__meta">
                <span class="song-card__tags">
                    @if (!string.IsNullOrWhiteSpace(item.Genre))
                    {
                        <span class="song-card__genre">@item.Genre</span>
                    }
                    @if (item.Year.HasValue)
                    {
                        <span class="song-card__year">@item.Year</span>
                    }
                </span>
            </div>
            <div class="song-card__ratings-row">
                <span class="song-card__ratings">
                    <span class="rating-grp">
                        @if (BayesScore is { } score)
                        {
                            <StarRating Value="RoundedAverage" Tone="hot" Sung="true" ReadOnly="true" />
                            <span class="rating-num">@score.ToString("0.0")</span>
                        }
                        else
                        {
                            <span class="rating-num rating-num--muted">—</span>
                        }
                    </span>
                    <span class="rating-sep"></span>
                    <span class="rating-grp">
                        @if (item.Enjoyment >= 1)
                        {
                            <StarRating Value="item.Enjoyment" Tone="cool" Sung="true" ReadOnly="true" />
                        }
                        else
                        {
                            <span class="rating-num rating-num--muted">—</span>
                        }
                    </span>
                </span>
            </div>
        </div>

        @if (ShowTonight)
        {
            <button type="button" class="btn btn-primary roll-result__primary" @onclick="OnAddToTonight" disabled="@InTonight">
                @(InTonight ? "Already in tonight's set" : "Add to Tonight")
            </button>
        }
        <div class="roll-result__row">
            <button type="button" class="btn btn-tonal" @onclick="OnOpen">Open song</button>
            <button type="button" class="btn btn-tonal" @onclick="OnReroll">🎲 Reroll</button>
        </div>
        <button type="button" class="btn-link roll-result__options" @onclick="OnOptions">Options</button>
    }
</Sheet>
