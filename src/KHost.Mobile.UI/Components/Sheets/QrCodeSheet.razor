@* Shows a QR code big enough for someone else's phone to scan off this screen. The code is handed in as
   pre-rendered SVG so this component stays display-only — no encoder dependency in the UI layer. *@
<Sheet Open="Open" AriaLabel="@AriaLabel" ClosePx="150" OnClose="OnClose">
    <div class="sheet__title">@Title</div>
    @if (!string.IsNullOrWhiteSpace(Subtitle))
    {
        <div class="sheet__subtitle">@Subtitle</div>
    }

    @* The quiet zone and module colors are fixed light regardless of theme: an inverted or tinted code
       is where phone scanners start failing. *@
    <div class="qr-code">@Svg</div>

    @if (!string.IsNullOrWhiteSpace(Caption))
    {
        <div class="qr-code__caption">@Caption</div>
    }
</Sheet>
