@inject IJSRuntime JS

@* The shell every bottom sheet sits in — backdrop, panel, ✕, and the pull-down-to-dismiss plumbing. Don't
   hand-roll khSheet.register in a page; wrap this instead.

   The page-scroll lock is synced from the DOM (khSheet.syncLock), not from any one caller's state, because sheets
   stack — a caller-driven lock would unlock the page out from under a sheet still showing. *@
@if (Open)
{
    <div class="sheet-backdrop @BackdropClass" @onclick="CloseAsync"></div>
    <div class="sheet @Class" role="dialog" aria-modal="true" aria-label="@AriaLabel" @ref="_el">
        @if (ShowClose)
        {
            <button type="button" class="sheet__close" @onclick="CloseAsync" aria-label="Close">✕</button>
        }
        @ChildContent
    </div>
}
