@inject IBackButtonService BackButton

@* A primary action segment + a chevron dropping a menu of related actions (<SplitButtonItem> children).
   Dismissed by tapping outside or by the Android back button, exactly like the header ⋮ menu. *@
<div class="kh-split @Class @(_open ? "is-open" : "")">
    <button type="button" class="btn @VariantBtnClass kh-split__main" disabled="@Disabled" @onclick="PrimaryClickAsync">
        @if (PrimaryContent is not null)
        {
            @PrimaryContent
        }
        else
        {
            @PrimaryLabel
        }
    </button>
    <button type="button" class="btn @VariantBtnClass kh-split__toggle" disabled="@Disabled"
            aria-haspopup="menu" aria-expanded="@_open" aria-label="@ToggleAriaLabel" @onclick="Toggle">
        <span class="kh-split__chev" aria-hidden="true">▾</span>
    </button>
    @if (_open)
    {
        @* Transparent full-screen catcher, so a tap anywhere outside the menu closes it. *@
        <div class="kh-split__scrim" @onclick="Close"></div>
        <div class="kh-split__menu kh-split__menu--@DirectionAttr kh-split__menu--@AlignAttr" role="menu">
            <CascadingValue Value="this" IsFixed="true">
                @ChildContent
            </CascadingValue>
        </div>
    }
</div>
