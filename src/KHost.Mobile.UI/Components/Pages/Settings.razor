@page "/settings"
@layout MainLayout
@using Microsoft.Extensions.Logging
@inject ILogger<Settings> Log
@inject IAppSettings Prefs
@inject ISongListStore Store
@inject ILyricsCache LyricsCache
@inject IAlbumArtCache AlbumArt
@inject IAlbumArtService AlbumArtService
@inject IAppSession Session
@inject NavigationManager Nav
@inject IBackButtonService BackButton
@implements IDisposable

<section class="settings">
    <div class="page-head">
        <NavLink class="page-back" href="" aria-label="Back to my songs"><ChevronLeftIcon Size="1.15em" /></NavLink>
        <h1 class="page-title">Settings</h1>
    </div>

    <div class="card">
        <button type="button" class="filters-toggle settings-section" @onclick='() => Toggle("tabs")' aria-expanded="@IsOpen("tabs")">
            <span class="filters-toggle__label">Tabs</span>
            <span class="filters-toggle__chevron @(IsOpen("tabs") ? "is-open" : "")">▾</span>
        </button>
        @if (IsOpen("tabs"))
        {
        <label class="setting">
            <span class="setting__text">
                <span class="setting__title">Enable “Tonight” Tab</span>
                <span class="setting__desc">
                    An on-deck set you build, reorder and check off. Off hides the tab; your set is kept.
                </span>
            </span>
            <span class="switch">
                <input class="switch__input" type="checkbox" @bind="Prefs.TonightEnabled" />
                <span class="switch__track"><span class="switch__thumb"></span></span>
            </span>
        </label>
        }
    </div>

    <div class="card" data-tut="settings-features">
        <button type="button" class="filters-toggle settings-section" @onclick='() => Toggle("mysongs")' aria-expanded="@IsOpen("mysongs")">
            <span class="filters-toggle__label">My Songs</span>
            <span class="filters-toggle__chevron @(IsOpen("mysongs") ? "is-open" : "")">▾</span>
        </button>
        @if (IsOpen("mysongs"))
        {
        <label class="setting">
            <span class="setting__text">
                <span class="setting__title">Enable Auto-fill Year &amp; Genre</span>
                <span class="setting__desc">Attempt to lookup year and genre when you add, open, or import songs.</span>
            </span>
            <span class="switch">
                <input class="switch__input" type="checkbox" @bind="Prefs.AutoFillMetadata" />
                <span class="switch__track"><span class="switch__thumb"></span></span>
            </span>
        </label>

        <label class="setting">
            <span class="setting__text">
                <span class="setting__title">Enable “Surprise me” Button</span>
                <span class="setting__desc">Tap the 🎲 on My Songs to pick a song at random.</span>
            </span>
            <span class="switch">
                <input class="switch__input" type="checkbox" @bind="Prefs.SurpriseEnabled" />
                <span class="switch__track"><span class="switch__thumb"></span></span>
            </span>
        </label>

        @* Mirrored from the 🎲's press-and-hold sheet: a long press has no assistive-tech equivalent, so these
           would otherwise be unreachable for anyone who can't perform one. *@
        @if (Prefs.SurpriseEnabled)
        {
            <label class="setting setting--sub">
                <span class="setting__text">
                    <span class="setting__title">Skip songs I've sung today</span>
                    <span class="setting__desc">If that rules out everything, it picks from the whole list anyway.</span>
                </span>
                <span class="switch">
                    <input class="switch__input" type="checkbox" @bind="Prefs.SurpriseSkipSungToday" />
                    <span class="switch__track"><span class="switch__thumb"></span></span>
                </span>
            </label>

            <label class="setting setting--sub">
                <span class="setting__text">
                    <span class="setting__title">Favour songs I sing well</span>
                </span>
                <span class="switch">
                    <input class="switch__input" type="checkbox" @bind="Prefs.SurpriseFavourWellSung" />
                    <span class="switch__track"><span class="switch__thumb"></span></span>
                </span>
            </label>

            <label class="setting setting--sub">
                <span class="setting__text">
                    <span class="setting__title">Only songs I've never sung</span>
                </span>
                <span class="switch">
                    <input class="switch__input" type="checkbox" @bind="Prefs.SurpriseNeverSungOnly" />
                    <span class="switch__track"><span class="switch__thumb"></span></span>
                </span>
            </label>

            <label class="setting setting--sub">
                <span class="setting__text">
                    <span class="setting__title">Only my favorites</span>
                </span>
                <span class="switch">
                    <input class="switch__input" type="checkbox" @bind="Prefs.SurpriseFavoritesOnly" />
                    <span class="switch__track"><span class="switch__thumb"></span></span>
                </span>
            </label>

            <label class="setting setting--sub">
                <span class="setting__text">
                    <span class="setting__title">Draw only from filtered songs</span>
                </span>
                <span class="switch">
                    <input class="switch__input" type="checkbox" @bind="Prefs.SurpriseRespectFilters" />
                    <span class="switch__track"><span class="switch__thumb"></span></span>
                </span>
            </label>
        }

        <label class="setting">
            <span class="setting__text">
                <span class="setting__title">Float favorites to the top</span>
                <span class="setting__desc">Keep favorites above the rest, whatever the sort.</span>
            </span>
            <span class="switch">
                <input class="switch__input" type="checkbox" @bind="Prefs.FloatFavoritesToTop" />
                <span class="switch__track"><span class="switch__thumb"></span></span>
            </span>
        </label>

        <label class="setting">
            <span class="setting__text">
                <span class="setting__title">Confirm before deleting a song</span>
                <span class="setting__desc">Ask before a swipe removes a song. Off leaves Undo as the only way back.</span>
            </span>
            <span class="switch">
                <input class="switch__input" type="checkbox" @bind="Prefs.ConfirmSongDelete" />
                <span class="switch__track"><span class="switch__thumb"></span></span>
            </span>
        </label>

        <label class="setting">
            <span class="setting__text">
                <span class="setting__title">Enable Song Spelling Assistant</span>
                <span class="setting__desc">Flag a name that's one slip from the provider's spelling.</span>
            </span>
            <span class="switch">
                <input class="switch__input" type="checkbox" @bind="SpellingAssistantEnabled" />
                <span class="switch__track"><span class="switch__thumb"></span></span>
            </span>
        </label>

        <label class="setting">
            <span class="setting__text">
                <span class="setting__title">Scroll to song when favorited</span>
                <span class="setting__desc">Starring a song scrolls the list to its new position.</span>
            </span>
            <span class="switch">
                <input class="switch__input" type="checkbox" @bind="Prefs.ScrollToFavorited" />
                <span class="switch__track"><span class="switch__thumb"></span></span>
            </span>
        </label>

        <label class="setting">
            <span class="setting__text">
                <span class="setting__title">Show album art on song cards</span>
                <span class="setting__desc">Use each song's cover as its card background. Covers are cached on this device.</span>
            </span>
            <span class="switch">
                <input class="switch__input" type="checkbox" @bind="Prefs.AlbumArtEnabled" />
                <span class="switch__track"><span class="switch__thumb"></span></span>
            </span>
        </label>

        <label class="setting">
            <span class="setting__text">
                <span class="setting__title">Show song tags</span>
                <span class="setting__desc">
                    Your own labels — “duet”, “closer” — as chips on a song, filterable. Off hides them; they're kept.
                </span>
            </span>
            <span class="switch">
                <input class="switch__input" type="checkbox" @bind="Prefs.TagsEnabled" />
                <span class="switch__track"><span class="switch__thumb"></span></span>
            </span>
        </label>
        }
    </div>

    <div class="card">
        <button type="button" class="filters-toggle settings-section" @onclick='() => Toggle("song")' aria-expanded="@IsOpen("song")">
            <span class="filters-toggle__label">Song Details</span>
            <span class="filters-toggle__chevron @(IsOpen("song") ? "is-open" : "")">▾</span>
        </button>
        @if (IsOpen("song"))
        {
        <label class="setting">
            <span class="setting__text">
                <span class="setting__title">Enable “Find on YouTube” Button</span>
                <span class="setting__desc">Opens a YouTube search from a song's detail sheet.</span>
            </span>
            <span class="switch">
                <input class="switch__input" type="checkbox" @bind="Prefs.YouTubeSearchEnabled" />
                <span class="switch__track"><span class="switch__thumb"></span></span>
            </span>
        </label>

        <label class="setting">
            <span class="setting__text">
                <span class="setting__title">Enable “Find on Spotify” Button</span>
                <span class="setting__desc">Opens a Spotify search from a song's detail sheet.</span>
            </span>
            <span class="switch">
                <input class="switch__input" type="checkbox" @bind="Prefs.SpotifySearchEnabled" />
                <span class="switch__track"><span class="switch__thumb"></span></span>
            </span>
        </label>

        <label class="setting">
            <span class="setting__text">
                <span class="setting__title">Enable “Lyrics” Button</span>
                <span class="setting__desc">Look a song's lyrics up from LRCLIB and read them in the app.</span>
            </span>
            <span class="switch">
                <input class="switch__input" type="checkbox" @bind="Prefs.LyricsEnabled" />
                <span class="switch__track"><span class="switch__thumb"></span></span>
            </span>
        </label>

        <label class="setting">
            <span class="setting__text">
                <span class="setting__title">Enable Lyrics Caching</span>
                <span class="setting__desc">Keep looked-up lyrics so they reopen instantly offline.</span>
            </span>
            <span class="switch">
                <input class="switch__input" type="checkbox" @bind="Prefs.LyricsCacheEnabled" />
                <span class="switch__track"><span class="switch__thumb"></span></span>
            </span>
        </label>
        }
    </div>

    <div class="card">
        <button type="button" class="filters-toggle settings-section" @onclick='() => Toggle("karafun")' aria-expanded="@IsOpen("karafun")">
            <span class="filters-toggle__label">KaraFun</span>
            <span class="filters-toggle__chevron @(IsOpen("karafun") ? "is-open" : "")">▾</span>
        </button>
        @if (IsOpen("karafun"))
        {
        <label class="setting">
            <span class="setting__text">
                <span class="setting__title">Enable KaraFun Features</span>
                <span class="setting__desc">
                    The “Find on KaraFun” button on a song, a venue's catalog button and QR code, and the KaraFun
                    ID field when you edit a venue. Off hides all of them; venues keep any ID already saved.
                </span>
            </span>
            <span class="switch">
                <input class="switch__input" type="checkbox" @bind="Prefs.KaraFunFeaturesEnabled" />
                <span class="switch__track"><span class="switch__thumb"></span></span>
            </span>
        </label>
        }
    </div>

    <div class="card">
        <button type="button" class="filters-toggle settings-section" @onclick='() => Toggle("venues")' aria-expanded="@IsOpen("venues")">
            <span class="filters-toggle__label">Venues</span>
            <span class="filters-toggle__chevron @(IsOpen("venues") ? "is-open" : "")">▾</span>
        </button>
        @if (IsOpen("venues"))
        {
        <label class="setting">
            <span class="setting__text">
                <span class="setting__title">Enable Venue Auto-detect</span>
                <span class="setting__desc">
                    Switch to the nearest saved venue as you move. Foreground only.
                </span>
            </span>
            <span class="switch">
                <input class="switch__input" type="checkbox" @bind="Prefs.LocationAutoDetect" />
                <span class="switch__track"><span class="switch__thumb"></span></span>
            </span>
        </label>

        @if (Prefs.LocationAutoDetect)
        {
            <label class="setting setting--stack">
                <span class="setting__text">
                    <span class="setting__title">Re-check location every</span>
                    <span class="setting__desc">How often to look again while the app is open.</span>
                </span>
                <select class="input venue-recheck" @bind="Prefs.VenueRecheckMinutes">
                    <option value="2">2 min</option>
                    <option value="5">5 min</option>
                    <option value="10">10 min</option>
                    <option value="15">15 min</option>
                    <option value="30">30 min</option>
                </select>
            </label>

            <label class="setting setting--stack">
                <span class="setting__text">
                    <span class="setting__title">Default Venue Radius</span>
                    <span class="setting__desc">Wider for a big room with a car park; tighter on a busy street.</span>
                </span>
                <select class="input setting-select" @bind="Prefs.VenueDetectionMeters">
                    @foreach (var (metres, feet) in VenueRadiusChoices)
                    {
                        <option value="@metres">@(Prefs.ShowDistanceInFeet ? feet : $"{metres} m")</option>
                    }
                </select>
            </label>

            <label class="setting setting--sub">
                <span class="setting__text">
                    <span class="setting__title">Show distances in feet</span>
                </span>
                <span class="switch">
                    <input class="switch__input" type="checkbox" @bind="Prefs.ShowDistanceInFeet" />
                    <span class="switch__track"><span class="switch__thumb"></span></span>
                </span>
            </label>
        }

        <label class="setting setting--stack">
            <span class="setting__text">
                <span class="setting__title">Venue history length</span>
                <span class="setting__desc">Go-to songs and recent performances listed per venue.</span>
            </span>
            <select class="input setting-select" @bind="Prefs.VenueHistoryEntries">
                <option value="3">3</option>
                <option value="5">5</option>
                <option value="10">10</option>
            </select>
        </label>
        }
    </div>

    <div class="card">
        <button type="button" class="filters-toggle settings-section" @onclick='() => Toggle("singing")' aria-expanded="@IsOpen("singing")">
            <span class="filters-toggle__label">Singing &amp; ratings</span>
            <span class="filters-toggle__chevron @(IsOpen("singing") ? "is-open" : "")">▾</span>
        </button>
        @if (IsOpen("singing"))
        {
        <label class="setting">
            <span class="setting__text">
                <span class="setting__title">Enable Performance Rating</span>
                <span class="setting__desc">
                    Ask “how did it go?” when you log one. Off still logs it, and takes a note.
                </span>
            </span>
            <span class="switch">
                <input class="switch__input" type="checkbox" @bind="Prefs.RatePerformances" />
                <span class="switch__track"><span class="switch__thumb"></span></span>
            </span>
        </label>

        <label class="setting">
            <span class="setting__text">
                <span class="setting__title">Favour recent form</span>
                <span class="setting__desc">
                    Fade older performances so current form leads the star. Your logged ratings are untouched.
                </span>
            </span>
            <span class="switch">
                <input class="switch__input" type="checkbox" @bind="Prefs.RecencyWeightedRatings" />
                <span class="switch__track"><span class="switch__thumb"></span></span>
            </span>
        </label>

        @if (Prefs.RecencyWeightedRatings)
        {
            <label class="setting setting--sub setting--stack">
                <span class="setting__text">
                    <span class="setting__title">“Recent” means</span>
                    <span class="setting__desc">How far back still counts as current form.</span>
                </span>
                <select class="input setting-select" @bind="Prefs.RecencyHalfLifeDays">
                    <option value="30">1 month</option>
                    <option value="90">3 months</option>
                    <option value="180">6 months</option>
                    <option value="365">1 year</option>
                </select>
            </label>
        }

        <label class="setting setting--stack">
            <span class="setting__text">
                <span class="setting__title">Trust a rating after</span>
                <span class="setting__desc">Until then its star leans on your list average.</span>
            </span>
            <select class="input setting-select" @bind="Prefs.RatingPriorWeight">
                <option value="1">1 performance</option>
                <option value="3">3 performances</option>
                <option value="8">8 performances</option>
            </select>
        </label>
        }
    </div>

    <div class="card">
        <button type="button" class="filters-toggle settings-section" @onclick='() => Toggle("app")' aria-expanded="@IsOpen("app")">
            <span class="filters-toggle__label">App</span>
            <span class="filters-toggle__chevron @(IsOpen("app") ? "is-open" : "")">▾</span>
        </button>
        @if (IsOpen("app"))
        {
        <label class="setting">
            <span class="setting__text">
                <span class="setting__title">Enable Update Notifications</span>
                <span class="setting__desc">Show a banner at startup when a newer release is out.</span>
            </span>
            <span class="switch">
                <input class="switch__input" type="checkbox" @bind="Prefs.UpdateCheckEnabled" />
                <span class="switch__track"><span class="switch__thumb"></span></span>
            </span>
        </label>

        <label class="setting">
            <span class="setting__text">
                <span class="setting__title">Enable Haptic Feedback</span>
                <span class="setting__desc">A short buzz confirms a press-and-hold.</span>
            </span>
            <span class="switch">
                <input class="switch__input" type="checkbox" @bind="Prefs.HapticsEnabled" />
                <span class="switch__track"><span class="switch__thumb"></span></span>
            </span>
        </label>

        <label class="setting">
            <span class="setting__text">
                <span class="setting__title">Enable 24-hour Time</span>
                <span class="setting__desc">Show 21:30 rather than 9:30 PM.</span>
            </span>
            <span class="switch">
                <input class="switch__input" type="checkbox" @bind="Prefs.Use24HourTime" />
                <span class="switch__track"><span class="switch__thumb"></span></span>
            </span>
        </label>

        <label class="setting setting--stack">
            <span class="setting__text">
                <span class="setting__title">Undo window</span>
                <span class="setting__desc">How long Undo stays after you remove something.</span>
            </span>
            <select class="input setting-select" @bind="Prefs.UndoWindowSeconds">
                <option value="5">5 seconds</option>
                <option value="10">10 seconds</option>
                <option value="30">30 seconds</option>
            </select>
        </label>

        <label class="setting setting--stack">
            <span class="setting__text">
                <span class="setting__title">Launch Tab</span>
                <span class="setting__desc">“Smart” opens Tonight only when a set is waiting.</span>
            </span>
            <select class="input setting-select" @bind="Prefs.LaunchDestination">
                <option value="smart">Smart</option>
                <option value="songs">My Songs</option>
                <option value="tonight">Tonight</option>
            </select>
        </label>

        <label class="setting setting--stack">
            <span class="setting__text">
                <span class="setting__title">Music catalogue region</span>
                <span class="setting__desc">Which country's catalogue auto-fill searches. Affects new lookups only.</span>
            </span>
            <select class="input setting-select" @bind="Prefs.CatalogueRegion">
                <option value="US">United States</option>
                <option value="GB">United Kingdom</option>
                <option value="CA">Canada</option>
                <option value="AU">Australia</option>
                <option value="IE">Ireland</option>
                <option value="NZ">New Zealand</option>
                <option value="DE">Germany</option>
                <option value="FR">France</option>
                <option value="ES">Spain</option>
                <option value="IT">Italy</option>
                <option value="NL">Netherlands</option>
                <option value="SE">Sweden</option>
                <option value="MX">Mexico</option>
                <option value="BR">Brazil</option>
                <option value="JP">Japan</option>
            </select>
        </label>

        <label class="setting setting--stack">
            <span class="setting__text">
                <span class="setting__title">Import lookup speed</span>
                <span class="setting__desc">Faster finishes sooner, but risks the provider refusing requests.</span>
            </span>
            <select class="input setting-select" @bind="Prefs.ImportLookupDelayMs">
                <option value="5000">Gentle</option>
                <option value="3000">Normal</option>
                <option value="1000">Fast</option>
            </select>
        </label>
        }
    </div>

    <div class="card">
        <button type="button" class="filters-toggle settings-section" @onclick='() => Toggle("help")' aria-expanded="@IsOpen("help")">
            <span class="filters-toggle__label">Help</span>
            <span class="filters-toggle__chevron @(IsOpen("help") ? "is-open" : "")">▾</span>
        </button>
        @if (IsOpen("help"))
        {
        <div class="setting" data-tut="settings-replay">
            <span class="setting__text">
                <span class="setting__title">Replay the tutorial</span>
                <span class="setting__desc">
                    Walk through the guided tour again.
                </span>
            </span>
            <button type="button" class="btn btn-secondary" @onclick="ReplayTutorial">Replay</button>
        </div>
        }
    </div>

    <div class="card" data-tut="settings-danger">
        <button type="button" class="filters-toggle settings-section" @onclick='() => Toggle("danger")' aria-expanded="@IsOpen("danger")">
            <span class="filters-toggle__label">Danger zone</span>
            <span class="filters-toggle__chevron @(IsOpen("danger") ? "is-open" : "")">▾</span>
        </button>
        @if (IsOpen("danger"))
        {
        <p class="setting__desc" style="margin:0.6rem 0 0.85rem">
            Empty the saved lyrics. They'll be looked up again next time you open them — nothing is lost for good.
        </p>
        <button type="button" class="btn btn-danger settings__clear" @onclick="ClearLyricsCacheAsync" disabled="@(_lyricsCacheCount == 0)">
            @(_lyricsCacheCount == 0 ? "Lyrics cache is empty" : $"Clear lyrics cache ({_lyricsCacheCount})")
        </button>

        <p class="setting__desc" style="margin:1.1rem 0 0.85rem">
            Delete the cached album-art images. They'll re-download next time you view those songs — nothing is lost.
        </p>
        <button type="button" class="btn btn-danger settings__clear" @onclick="ClearAlbumArtCacheAsync" disabled="@(_albumArtCount == 0)">
            @(_albumArtCount == 0 ? "Album art cache is empty" : $"Clear album art cache ({_albumArtCount})")
        </button>

        <p class="setting__desc" style="margin:1.1rem 0 0.85rem">
            Remove every song from your list. This can't be undone.
        </p>
        <button type="button" class="btn btn-danger settings__clear" @onclick="AskClear" disabled="@(_songCount == 0)">
            @(_songCount == 0 ? "Song list is empty" : $"Clear song list ({_songCount})")
        </button>
        }
    </div>
</section>

@if (_confirmClear)
{
    <div class="sheet-backdrop sheet-backdrop--confirm" @onclick="CancelClear"></div>
    <div class="confirm-pop" role="alertdialog" aria-modal="true">
        <div class="confirm-pop__title">Clear your whole song list?</div>
        <div class="confirm-pop__date">This removes all @_songCount song@(_songCount == 1 ? "" : "s") and can't be undone.</div>
        <div class="confirm-pop__actions">
            <button class="btn btn-secondary" @onclick="CancelClear">Cancel</button>
            <button class="btn confirm-pop__delete" @onclick="ConfirmClearAsync">Clear all</button>
        </div>
    </div>
}

@code {
    // The clear buttons are gated on / labeled with their live counts, so track both and refresh on any change.
    private int _songCount;
    private int _lyricsCacheCount;
    private int _albumArtCount;
    private bool _confirmClear;

    // Stored as an int so a future "eager" tier needs no migration; until that exists it's a plain on/off switch.
    private bool SpellingAssistantEnabled
    {
        get => Prefs.SpellingSuggestionLevel > 0;
        set => Prefs.SpellingSuggestionLevel = value ? 1 : 0;
    }

    // Radii are stored in metres; the feet labels are the round numbers a US singer expects, not exact conversions
    // (250 ft is 76.2 m), so the pairs are spelled out rather than computed.
    private static readonly (int Metres, string Feet)[] VenueRadiusChoices =
    [
        (15, "50 ft"), (30, "100 ft"), (75, "250 ft"), (150, "500 ft"), (300, "1000 ft"),
    ];

    // Collapsible sections: default to all expanded, so nothing is hidden on first visit.
    private readonly HashSet<string> _collapsed = [];
    private bool IsOpen(string id) => !_collapsed.Contains(id);
    private void Toggle(string id) { if (!_collapsed.Add(id)) _collapsed.Remove(id); }

    protected override async Task OnInitializedAsync()
    {
        _backGuard = new BackButtonOverlayGuard(BackButton,
            closeTopMost: TryCloseTopOverlay,
            notifyStateChanged: StateHasChanged);
        Store.Changed += OnStoreChanged;
        LyricsCache.Changed += OnStoreChanged;
        AlbumArt.Changed += OnStoreChanged;
        await RefreshCountAsync();
    }

    // Routes the Android back button to close the top-most overlay instead of navigating; active only while one is open.
    private BackButtonOverlayGuard? _backGuard;

    // Closes the confirm-clear pop-up — the only overlay this page has.
    private bool TryCloseTopOverlay()
    {
        if (_confirmClear) { CancelClear(); return true; }
        return false;
    }

    // Same non-async-void bridge the other pages use: marshal the reload onto the render thread and swallow failures.
    private void OnStoreChanged(object? sender, EventArgs e) => _ = RefreshFromStoreAsync();

    private async Task RefreshFromStoreAsync()
    {
        try { await InvokeAsync(RefreshCountAsync); }
        catch (Exception ex)
        {
            // best-effort: a failed count refresh just leaves the last-known value
            Log.LogWarning(ex, "Settings count refresh failed");
        }
    }

    private async Task RefreshCountAsync()
    {
        _songCount = (await Store.GetAllAsync()).Count;
        _lyricsCacheCount = await LyricsCache.CountAsync();
        _albumArtCount = await AlbumArt.CountAsync();
        StateHasChanged();
    }

    // Cached lyrics are recoverable (they re-fetch on next open), so this clears straight away — no confirm sheet.
    private async Task ClearLyricsCacheAsync()
    {
        await LyricsCache.ClearAsync();   // LyricsCache.Changed → RefreshCountAsync updates the count + button
    }

    // Cached covers re-download on next view, so this also clears straight away — no confirm sheet.
    private async Task ClearAlbumArtCacheAsync()
    {
        await AlbumArt.ClearAsync();   // AlbumArt.Changed → RefreshCountAsync updates the count + button
        // The images already handed to the WebView are a separate copy: without this, deleting the files leaves
        // every visible card still showing its cover, so the button looks like it did nothing.
        await AlbumArtService.ClearAsync();
    }

    private void AskClear()
    {
        if (_songCount > 0)
            _confirmClear = true;
    }

    private void CancelClear() => _confirmClear = false;

    // TutorialOverlay picks up the navigation to "/" via LocationChanged and kicks off the tour.
    private void ReplayTutorial()
    {
        Prefs.TutorialCompleted = false;
        Session.TutorialResolved = false;
        Nav.NavigateTo("/");
    }

    private async Task ConfirmClearAsync()
    {
        _confirmClear = false;
        await Store.ClearAsync();   // Store.Changed → RefreshCountAsync updates the count + button
    }

    public void Dispose()
    {
        _backGuard?.Dispose();
        Store.Changed -= OnStoreChanged;
        LyricsCache.Changed -= OnStoreChanged;
        AlbumArt.Changed -= OnStoreChanged;
    }
}
