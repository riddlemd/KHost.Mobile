@page "/singers"
@layout MainLayout
@using Microsoft.Extensions.Logging
@inject ILogger<Singers> Log
@inject ISingerStore Store
@inject IAppSession Session
@inject IAppSettings Settings
@inject NavigationManager Nav
@inject IBackButtonService BackButton
@inject IJSRuntime JS
@inject IHaptics Haptics

@* Row gestures come from swipe.js with swipeEnabled:false — a singer is removed from the edit sheet, never by swipe.
   The sheet's "Active" toggle is the equivalent a screen reader can reach, since hold has no accessible gesture. *@
<section class="singers">
    <div class="page-head">
        <NavLink class="page-back" href="" aria-label="Back to my songs"><ChevronLeftIcon Size="1.15em" /></NavLink>
        <h1 class="page-title">Singers</h1>
        <button type="button" class="btn btn-secondary page-head__add" data-tut="singer-add" @onclick="OpenAdd">＋ Add</button>
    </div>

    <div class="list-hint">Press and hold a singer to switch to them.</div>
    <div class="singer-list" @ref="_gestureRoot">
        @foreach (var s in _singers)
        {
            @* data-tut is on every row; the tour's querySelector spotlights the first one. *@
            <div class="singer-row @(IsActive(s) ? "is-active" : "")" @key="s.Id" data-singer-id="@s.Id" data-tut="singer-hold">
                <span class="singer-av" style="background:@s.Color;">@s.Avatar</span>
                <div class="singer-row__main">
                    <div class="singer-row__name">
                        @s.Name
                        @if (IsActive(s))
                        {
                            <span class="singer-row__badge">Active</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@* ---- Add / edit sheet ---- *@
<SingerEditSheet Editing="_editing" IsNew="_editingIsNew" CanDelete="_singers.Count > 1"
                 IsActive="@(_editing is not null && Session.ActiveSingerId == _editing.Id)"
                 OnSave="SaveAsync" OnDelete="DeleteAsync" OnSetActive="SetActiveFromSheet" OnClose="CloseEdit" />
