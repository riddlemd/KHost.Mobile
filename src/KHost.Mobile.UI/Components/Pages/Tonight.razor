@page "/tonight"
@using Microsoft.Extensions.Logging
@inject ISongListStore Store
@inject ITonightStore TonightStore
@inject IAppSettings Settings
@inject IAppSession Session
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IBackButtonService BackButton
@inject ILinkLauncher Links
@inject IVenueStore Venues
@inject IAlbumArtService AlbumArt
@inject ILogger<Tonight> Log
@inject TimeProvider Clock
@inject ISongLinkBuilder Links2
@inject IRatingScorer Scorer

@if (_loading)
{
    <div class="loading-state" role="status" aria-live="polite">
        <div class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
        <div class="loading-state__title">Loading tonight's set…</div>
    </div>
}
else if (_tonight.Count == 0)
{
    <div class="empty-state tonight-empty">
        <div class="empty-state__icon">🎤</div>
        <div class="empty-state__title">Nothing queued yet</div>
        <div>Pick songs from My Songs and tap “Add to tonight” on a card to line up your set.</div>
        <button class="btn btn-primary tonight-empty__cta" @onclick="GoToMySongs">Browse My Songs</button>
    </div>
}
else
{
    <div class="card tonight">
        <div class="tonight__head tonight__head--static" data-tut="tonight-set">
            <span class="tonight__mic">🎤</span>
            <span class="tonight__title">Tonight</span>
            <span class="tonight__progress">@ProgressLabel</span>
        </div>
        <div class="tonight__progressbar"><span style="width:@Pct%"></span></div>
        <div class="tonight__body" @ref="_list">
            @foreach (var (entry, song) in Rows())
            {
                @* data-tut anchors are on every row; the tour's querySelector spotlights the first one. *@
                var art = AlbumArt.ViewFor(song);
                <div class="setrow @(entry.Completed ? "done" : "") @(art.HasArt ? "setrow--art" : "") @(art.Loading ? "kh-art-loading" : "")"
                     style="@art.Style" @key="entry.SongId" data-song-id="@entry.SongId" data-art-song="@entry.SongId">
                    <span class="setrow__handle" title="Drag to reorder" data-tut="tonight-reorder">⠿</span>
                    <span class="setrow__pos">@(entry.Order + 1)</span>
                    <div class="setrow__main setrow__main--tappable" role="button" tabindex="0"
                         @onclick="() => OpenDetail(song)" @onkeydown="e => OnRowKeyDown(e, song)">
                        <div class="setrow__title">@song.Title</div>
                        @if (!string.IsNullOrWhiteSpace(song.Artist))
                        {
                            <div class="setrow__artist">@song.Artist</div>
                        }
                    </div>
                    <button type="button" class="setrow__check" aria-pressed="@entry.Completed" data-tut="tonight-check"
                            title="@(entry.Completed ? "Undo performance" : "Log performance")"
                            @onclick="() => ToggleDoneAsync(entry, song)">✓</button>
                    <button type="button" class="setrow__remove" title="Remove from tonight"
                            @onclick="() => ArmRemove(song)">✕</button>
                </div>
            }
        </div>
        <div class="tonight__foot">
            <button type="button" class="btn tonight__end" @onclick="AskEndNight">End night</button>
        </div>
    </div>
}

<RatingPromptSheet Item="_ratingPromptItem" RatePerformances="Settings.RatePerformances"
                   OnCommit="OnRatingCommitAsync" OnCancel="OnRatingCancel" />

@* The card renders a button only for the callbacks it's given. Log performance / the tonight toggle / Lyrics are
   left unwired on purpose: the row's own ✓ / ✕ own the set mechanics, and the card's versions wouldn't complete
   the row. *@
<SongDetailSheet Item="_detailItem" AllowEdit="false"
                 InTonight="true"
                 KaraFunAvailable="@(Settings.KaraFunFeaturesEnabled && !string.IsNullOrWhiteSpace(_activeVenueKaraFunId))"
                 BayesScore="DetailStar"
                 RoundedAverage="@(DetailStar is { } s ? (int)Math.Round(s, MidpointRounding.AwayFromZero) : 0)"
                 OnClose="CloseDetail"
                 OnOpenHistory="OpenHistory"
                 OnOpenYouTube="OpenYouTubeAsync" OnOpenSpotify="OpenSpotifyAsync"
                 OnOpenKaraFun="OpenKaraFunAsync"
                 OnEnjoymentChanged="UpdateEnjoymentAsync" />

<PerformanceHistorySheet Item="_historyItem"
                  BayesScore="@(_historyItem is null ? null : Scorer.StarFor(_historyItem, _ratingContext))"
                  OnRatingChanged="e => UpdatePerformanceRatingAsync(e.Index, e.Value)"
                  OnNoteChanged="e => UpdatePerformanceNoteAsync(e.Index, e.Note)"
                  OnDateChanged="e => UpdatePerformanceDateAsync(e.Index, e.Date)"
                  OnRemove="RemovePerformanceAsync"
                  OnRestore="e => RestorePerformanceAsync(e.Index, e.Performance)"
                  OnClose="CloseHistory"
                  @ref="_historySheetRef" />

@if (_removeSong is not null)
{
    <div class="sheet-backdrop sheet-backdrop--confirm" @onclick="CancelRemove"></div>
    <div class="confirm-pop" role="alertdialog" aria-modal="true">
        <div class="confirm-pop__title">Remove from tonight?</div>
        <div class="confirm-pop__date">“@_removeSong.Title” drops off tonight's set. It stays in your song list.</div>
        <div class="confirm-pop__actions">
            <button class="btn btn-secondary" @onclick="CancelRemove">Cancel</button>
            <button class="btn confirm-pop__delete" @onclick="ConfirmRemoveAsync">Remove</button>
        </div>
    </div>
}

@if (_confirmEndNight)
{
    <div class="sheet-backdrop sheet-backdrop--confirm" @onclick="CancelEndNight"></div>
    <div class="confirm-pop" role="alertdialog" aria-modal="true">
        <div class="confirm-pop__title">End the night?</div>
        <div class="confirm-pop__date">Clears tonight's @_tonight.Count-song set. Songs you sang stay in your history.</div>
        <div class="confirm-pop__actions">
            <button class="btn btn-secondary" @onclick="CancelEndNight">Cancel</button>
            <button class="btn confirm-pop__delete" @onclick="EndNightAsync">End night</button>
        </div>
    </div>
}
